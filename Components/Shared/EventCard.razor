<article class="event-card @(EventItem.IsFull ? "is-full" : "") @(EventItem.IsUpcoming ? "" : "is-past")">
    <div class="event-card-image">
        <img src="@EventItem.ImageUrl" alt="@EventItem.Name" loading="lazy" />
        <span class="badge badge-category">@EventItem.Category</span>
        @if (IsRegistered)
        {
            <span class="badge badge-success badge-corner">✓ Registered</span>
        }
    </div>

    <div class="event-card-body">
        <h3 class="event-card-title">@EventItem.Name</h3>
        <p class="event-card-desc">@EventItem.Description</p>

        <ul class="event-meta">
            <li><span aria-hidden="true">📅</span> @EventItem.EventDate.ToString("ddd, dd MMM yyyy")</li>
            <li><span aria-hidden="true">🕒</span> @EventItem.StartTime.ToString("hh:mm tt")</li>
            <li><span aria-hidden="true">📍</span> @EventItem.Location</li>
        </ul>

        <div class="seats">
            <div class="seats-text">
                <span class="seats-label @SeatsClass">@SeatsText</span>
                <span class="muted">@EventItem.AvailableSeats / @EventItem.MaxCapacity seats</span>
            </div>
            <div class="progress"><div class="progress-bar @SeatsClass" style="width:@(FilledPercent)%"></div></div>
        </div>

        @* Two-way data binding: the checkbox is bound to _saved with @bind,
           and the parent is told about every change through IsSavedChanged. *@
        <label class="save-toggle">
            <input type="checkbox" @bind="_saved" @bind:after="SavedChangedAsync" />
            Save for later
        </label>
    </div>

    <div class="event-card-actions">
        <a class="btn btn-outline" href="events/@EventItem.Id">View Details</a>
        @if (!EventItem.IsUpcoming)
        {
            <span class="btn btn-disabled" aria-disabled="true">Event Ended</span>
        }
        else if (EventItem.IsFull)
        {
            <span class="btn btn-disabled" aria-disabled="true">Sold Out</span>
        }
        else
        {
            <a class="btn btn-primary" href="register/@EventItem.Id">Register Now</a>
        }
    </div>
</article>

@code {
    /// <summary>The event to display.</summary>
    [Parameter, EditorRequired] public Event EventItem { get; set; } = default!;

    /// <summary>Parent -> child: is this event saved? Together with IsSavedChanged this is a two-way binding.</summary>
    [Parameter] public bool IsSaved { get; set; }

    /// <summary>Child -> parent: raised when the user toggles "Save for later".</summary>
    [Parameter] public EventCallback<bool> IsSavedChanged { get; set; }

    /// <summary>Shows a "Registered" badge when the current user already registered.</summary>
    [Parameter] public bool IsRegistered { get; set; }

    private bool _saved;

    protected override void OnParametersSet() => _saved = IsSaved;

    private Task SavedChangedAsync() => IsSavedChanged.InvokeAsync(_saved);

    private int FilledPercent => EventItem.MaxCapacity <= 0
        ? 100
        : (int)Math.Round(EventItem.RegisteredCount * 100.0 / EventItem.MaxCapacity);

    private string SeatsClass => EventItem.IsFull ? "seats-full"
        : EventItem.AvailableSeats <= Math.Max(1, EventItem.MaxCapacity * 0.2) ? "seats-low"
        : "seats-ok";

    private string SeatsText => EventItem.IsFull ? "Sold out"
        : SeatsClass == "seats-low" ? $"Only {EventItem.AvailableSeats} left!"
        : $"{EventItem.AvailableSeats} seats left";
}
